rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /coins/{coinId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /preferences/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && docId == 'settings'
          && validPreferences(request.resource.data);
      }

      match /watchlist/{coinId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

function validPreferences(data) {
  return data.keys().hasAll(['riskTolerance', 'minMarketCapUsd', 'enabledCategories', 'sortBy'])
    && data.riskTolerance in ['conservative', 'balanced', 'aggressive']
    && data.minMarketCapUsd is number
    && data.minMarketCapUsd >= 0
    && data.minMarketCapUsd <= 1000000000000
    && data.enabledCategories is list
    && data.sortBy in ['investScore', 'marketCap', 'volume24h'];
}
