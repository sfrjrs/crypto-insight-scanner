# Used by: npm run agent (production)
# Copy this file to .env and fill in the values.

# Firebase project ID (must match .firebaserc and environment.prod.ts)
FIREBASE_PROJECT_ID=crypto-insight-scanner

# Path to a Firebase service account JSON key, downloaded from:
# Firebase Console → Project Settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: CoinGecko Pro API key for higher rate limits (leave empty for free tier)
COINGECKO_API_KEY=
